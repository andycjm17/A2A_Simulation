  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.8",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "3.9.6",
    "typescript": "^5.9.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.0",
    "wrangler": "4.131.1"
  }
