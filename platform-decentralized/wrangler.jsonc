{
  "name": "andycui-a2a-lab",
  "account_id": "e1ed3db53809ba2f6761f0e2e5138b23",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "test.a2asimulation.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MARKETS",
        "class_name": "MarketRoom"
      },
      {
        "name": "CATALOG",
        "class_name": "MarketCatalog"
      },
      {
        "name": "OAUTH_REPLAY",
        "class_name": "OAuthReplayGuard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MarketRoom",
        "MarketCatalog"
      ]
    },
    {
      "tag": "v2-oauth",
      "new_sqlite_classes": ["OAuthReplayGuard"]
    }
  ],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "64fdcad1b457469c9f3a4ce1d6d6504b" }
  ],
  "vars": {
    "APP_ORIGIN": "https://test.a2asimulation.com",
    "LAB_ENV": "decentralization-test"
  },
  "ratelimits": [
    {
      "name": "OAUTH_LIMITER",
      "namespace_id": "2063",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "IP_LIMITER",
      "namespace_id": "2061",
      "simple": {
        "limit": 3000,
        "period": 60
      }
    },
    {
      "name": "NETWORK_LIMITER",
      "namespace_id": "2062",
      "simple": {
        "limit": 6000,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
